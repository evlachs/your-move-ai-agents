# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- Yandex Cloud Logging ---
# IAM-токен: yc iam create-token (живёт ~12 часов — для длительной работы
# нужно периодически обновлять переменную окружения)
YC_IAM_TOKEN=your_iam_token
# ID группы логов: Yandex Cloud Console → Cloud Logging → группа логов → её id
LOG_GROUP_ID=e23xxxxxxxxxxxxxxxxx

# --- YandexGPT ---
# API-ключ: в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx

# --- SMTP (доставка дайджеста) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-bot@yandex.ru
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your-bot@yandex.ru
EMAIL_TO=recipient@example.com

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание ---
CHECK_INTERVAL_HOURS=1
TIMEZONE=Europe/Moscow
