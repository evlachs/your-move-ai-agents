# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- GitHub ---
# Personal Access Token с правом repo (или Fine-grained token с правами pull_requests: read+write)
# Создать: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Репозиторий в формате owner/repo
GITHUB_REPO=myorg/myrepo

# Ревьюить только PR в эту ветку. Оставьте пустым, чтобы ревьюить все открытые PR.
GITHUB_BASE_BRANCH=main

# --- Ограничения diff ---
# Максимальный размер diff (в символах), который передаётся в YandexGPT.
# Слишком большой diff даёт расплывчатое ревью. Рекомендуется 6000–10000.
MAX_DIFF_CHARS=8000

# --- YandexGPT ---
# API-ключ:  в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_iam_token_or_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# Модель: yandexgpt-lite (быстрее/дешевле) или yandexgpt (лучше для код-ревью)
YANDEX_GPT_MODEL=yandexgpt

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание ---
CHECK_INTERVAL_HOURS=1
TIMEZONE=Europe/Moscow
