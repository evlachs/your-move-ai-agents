# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- Папка с аудиозаписями ---
# Агент будет сканировать эту папку на новые файлы при каждом запуске.
# В Docker смонтируй папку через -v /path/on/host:/app/audio
AUDIO_DIR=audio
# .m4a не поддерживается: SpeechKit STT v1 умеет только LINEAR16_PCM/OGG_OPUS/MP3,
# а .m4a (AAC в MP4) не сводится ни к одному из них без предварительной перекодировки.
AUDIO_EXTENSIONS=.mp3,.ogg,.wav

# --- Yandex SpeechKit ---
# API-ключ и Folder ID — в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_iam_token_or_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# Язык распознавания (ru-RU, en-US, ...)
SPEECHKIT_LANGUAGE=ru-RU
# Модель: general (универсальная) или другие доступные модели SpeechKit
SPEECHKIT_MODEL=general
# Интервал опроса статуса операции (секунд). Для коротких файлов можно уменьшить.
SPEECHKIT_POLL_INTERVAL=10
# Максимум проверок статуса. Таймаут = POLL_INTERVAL × MAX_POLLS (по умолчанию 10 мин)
SPEECHKIT_MAX_POLLS=60

# --- YandexGPT ---
# Модель для анализа транскриптов: yandexgpt-lite (быстрее/дешевле) или yandexgpt
YANDEX_GPT_MODEL=yandexgpt-lite

# --- SMTP (доставка заметок) ---
# Для Яндекс Почты нужен пароль приложения, а не основной пароль аккаунта:
# Настройки → Безопасность → Пароли приложений → создать пароль для почты
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-mail@yandex.ru
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your-mail@yandex.ru
EMAIL_TO=recipient@example.com

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание ---
# Как часто проверять папку с новыми аудиофайлами (часы)
CHECK_INTERVAL_HOURS=1
TIMEZONE=Europe/Moscow
