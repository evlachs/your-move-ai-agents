# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- GitHub (целевой репозиторий, который агент документирует) ---
# Токену нужны права на запись: contents (создание веток/коммитов) и
# pull requests (открытие PR). Personal Access Token с scope 'repo'.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
TARGET_REPO=owner/repository-name
TARGET_BRANCH=main

# --- YandexGPT ---
# IAM-токен: yc iam create-token
# API-ключ:  в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_iam_token_or_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx

# --- Документация ---
# Путь к файлу подробной документации в целевом репозитории
DOC_PATH=docs/DOCUMENTATION.md

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание ---
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
TIMEZONE=Europe/Moscow
