# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- IMAP (рабочая почта, которую агент проверяет) ---
# Для Яндекс Почты нужен пароль приложения, а не основной пароль аккаунта:
# Настройки → Безопасность → Пароли приложений → создать пароль для почты
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USER=your-work-mail@yandex.ru
IMAP_PASSWORD=your_app_password
IMAP_MAILBOX=INBOX

# --- YandexGPT ---
# IAM-токен: yc iam create-token
# API-ключ:  в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_iam_token_or_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx

# --- SMTP (доставка дайджеста) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-work-mail@yandex.ru
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your-work-mail@yandex.ru
EMAIL_TO=recipient@example.com

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание: два запуска в день ---
LUNCH_HOUR=13
LUNCH_MINUTE=0
EVENING_HOUR=18
EVENING_MINUTE=0
TIMEZONE=Europe/Moscow
