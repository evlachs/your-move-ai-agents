# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- YandexGPT / YandexART ---
# IAM-токен: yc iam create-token
# API-ключ:  в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_iam_token_or_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx

# --- VK ---
# Ключ доступа сообщества: Управление сообществом → Работа с API →
# Создать ключ → права wall, photos
VK_ACCESS_TOKEN=your_vk_community_access_token
VK_GROUP_ID=123456789

# --- Публикация ---
# Час, на который ставится отложенная запись (агент готовит пост на завтра)
PUBLISH_HOUR=12

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание запуска агента ---
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
TIMEZONE=Europe/Moscow
