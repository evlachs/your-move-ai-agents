# --- Google Sheets ---
# Публикуйте таблицу: Файл → Поделиться → Опубликовать в интернете → CSV
# Либо сделайте таблицу публичной (Все с ссылкой → Читатель) и используйте:
# https://docs.google.com/spreadsheets/d/{ID}/export?format=csv
SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv

# Название колонки с текстом отзыва (должно точно совпадать с заголовком)
TEXT_COLUMN=Отзыв

# Колонка с уникальным ID строки (оставьте пустым — будет использован хэш текста)
ID_COLUMN=

# --- Ограничения ---
# Максимальное количество новых отзывов за один запуск
MAX_REVIEWS_PER_RUN=50

# --- YandexGPT ---
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-folder-id
YANDEX_GPT_MODEL=yandexgpt-lite

# --- SMTP (Яндекс Почта) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=agent@yandex.ru
SMTP_PASSWORD=app-password-here
EMAIL_FROM=agent@yandex.ru
EMAIL_TO=recipient@example.com

# --- Расписание ---
DIGEST_HOUR=9
DIGEST_MINUTE=0
TIMEZONE=Europe/Moscow

# --- База данных ---
DB_PATH=data/agent_memory.db
