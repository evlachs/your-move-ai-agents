# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- Фильтры поиска HH.ru ---
# Ключевые слова для поиска (обязательно)
HH_SEARCH_TEXT=Python разработчик

# ID региона: 1 = Москва, 2 = Санкт-Петербург, 113 = вся Россия
# Полный список: https://api.hh.ru/areas
HH_AREA_ID=2

# Минимальная зарплата (0 = без ограничения)
HH_SALARY_FROM=0

# Показывать только вакансии с указанной зарплатой (true/false)
HH_ONLY_WITH_SALARY=false

# Требуемый опыт: noExperience | between1And3 | between3And6 | moreThan6 | (пусто = любой)
HH_EXPERIENCE=

# Тип занятости: full | part | project | (пусто = любой)
HH_EMPLOYMENT=

# Сколько вакансий запрашивать за один раз (максимум 100)
HH_PER_PAGE=50

# --- Профиль соискателя ---
# Краткое описание: кто ищет работу и что важно.
# YandexGPT использует это для оценки релевантности вакансии.
# Оставьте пустым, чтобы GPT оценивал без контекста.
CANDIDATE_PROFILE=Junior Python-разработчик, ищу backend-позицию. Знаю FastAPI, PostgreSQL, Docker. Важна удалённая работа или гибрид.

# --- YandexGPT ---
# API-ключ:  в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_iam_token_or_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# Модель: yandexgpt-lite (быстрее/дешевле) или yandexgpt
YANDEX_GPT_MODEL=yandexgpt-lite

# --- SMTP (доставка дайджеста) ---
# Для Яндекс Почты нужен пароль приложения, а не основной пароль аккаунта:
# Настройки → Безопасность → Пароли приложений → создать пароль для почты
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-mail@yandex.ru
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your-mail@yandex.ru
EMAIL_TO=recipient@example.com

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание ---
# Как часто проверять HH.ru (часы). По умолчанию — каждые 4 часа.
CHECK_INTERVAL_HOURS=4
TIMEZONE=Europe/Moscow
