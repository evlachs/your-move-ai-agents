# Скопируй этот файл в .env и заполни своими значениями
# cp env.example .env

# --- RSS-ленты ---
# Список URL-адресов через точку с запятой (;)
RSS_FEEDS=https://habr.com/ru/rss/best/daily/;https://habr.com/ru/rss/hubs/python/articles/

# Сколько последних записей брать из каждой ленты за один запуск
# Ограничивает объём на первом запуске, когда вся история ещё не помечена как виденная
MAX_ENTRIES_PER_FEED=20

# --- Тематика дайджеста (необязательно) ---
# YandexGPT использует это как контекст при суммаризации.
# Оставьте пустым, чтобы суммаризировать все записи без фильтра по теме.
DIGEST_TOPICS=Python, ИИ, разработка

# --- YandexGPT ---
# API-ключ:  в консоли Яндекс Клауд → Сервисные аккаунты
YANDEX_API_KEY=your_iam_token_or_api_key
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# Модель: yandexgpt-lite (быстрее/дешевле) или yandexgpt
YANDEX_GPT_MODEL=yandexgpt-lite

# --- SMTP (доставка дайджеста) ---
# Для Яндекс Почты нужен пароль приложения, а не основной пароль аккаунта:
# Настройки → Безопасность → Пароли приложений → создать пароль для почты
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-mail@yandex.ru
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your-mail@yandex.ru
EMAIL_TO=recipient@example.com

# --- Хранилище ---
DB_PATH=data/agent_memory.db

# --- Расписание: один раз в день ---
DIGEST_HOUR=9
DIGEST_MINUTE=0
TIMEZONE=Europe/Moscow
